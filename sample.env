# Fully local inference. Setup downloads weights once; analysis stays offline.
LOCAL_SAMPLE_FPS=5
LOCAL_IMAGE_SIZE=960
LOCAL_DEVICE=auto
LOCAL_DETECTION_CONFIDENCE=0.25
OBJECT_DETECTION_ENABLED=true
OBJECT_SAMPLE_FPS=2
OBJECT_IMAGE_SIZE=640
# Uses the prepared box-capable model when present; an explicit path overrides auto selection.
# LOCAL_OBJECT_MODEL_PATH=/absolute/path/to/yolov8s-world-boxes.pt
# LOCAL_MODEL_PATH=/absolute/path/to/yolo11n-pose.pt
BEHAVIOR_MIN_SECONDS=1
BEHAVIOR_WINDOW_SECONDS=4
BEHAVIOR_MERGE_GAP_SECONDS=0.4
BEHAVIOR_CLOSE_HEIGHTS=0.8
BEHAVIOR_SPEED_HEIGHTS=0.15
MAX_VIDEO_SIZE_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=60
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
